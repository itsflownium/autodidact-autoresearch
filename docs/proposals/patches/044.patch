+def curriculum_sequence_length(
+    completed_tokens: int,
+    *,
+    target_tokens: int,
+    initial_sequence_length: int,
+    maximum_sequence_length: int,
+    curriculum_ratio: float,
+) -> int:
+    """Linearly grow training context early in the token budget."""
+
+    if target_tokens <= 0:
+        raise ValueError("target_tokens must be positive")
+    if not 0 < initial_sequence_length <= maximum_sequence_length:
+        raise ValueError("initial sequence length must be in the model context range")
+    if not 0.0 <= curriculum_ratio <= 1.0:
+        raise ValueError("context curriculum ratio must be in [0, 1]")
+    curriculum_tokens = int(target_tokens * curriculum_ratio)
+    if curriculum_tokens == 0 or completed_tokens >= curriculum_tokens:
+        return maximum_sequence_length
+    progress = max(completed_tokens, 0) / curriculum_tokens
+    span = maximum_sequence_length - initial_sequence_length
+    return initial_sequence_length + int(span * progress)
+
+
