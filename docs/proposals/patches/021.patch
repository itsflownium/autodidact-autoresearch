+class CausalDepthwiseConv1d(nn.Module):
+    """Mix recent per-channel MLP features without looking ahead."""
+
+    def __init__(self, width: int, kernel_size: int = 3) -> None:
+        super().__init__()
+        self.kernel_size = kernel_size
+        self.convolution = nn.Conv1d(
+            width,
+            width,
+            kernel_size,
+            groups=width,
+            bias=False,
+        )
+        nn.init.zeros_(self.convolution.weight)
+        with torch.no_grad():
+            self.convolution.weight[:, 0, -1] = 1.0
+
+    def forward(self, inputs: torch.Tensor) -> torch.Tensor:
+        channels_first = inputs.transpose(1, 2)
+        padded = F.pad(channels_first, (self.kernel_size - 1, 0))
+        return self.convolution(padded).transpose(1, 2)
+
+
